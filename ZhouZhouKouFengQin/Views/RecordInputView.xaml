<UserControl x:Class="GameMusicPlayer.Views.RecordInputView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI, Microsoft YaHei UI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 头部 -->
        <Grid Grid.Row="0" Margin="2,0,2,12">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="4" Height="22" CornerRadius="2" Background="{StaticResource AccentBrush}" Margin="0,0,12,0"/>
                <TextBlock Text="手动录入" Style="{StaticResource SectionTitle}" FontSize="17"/>
                <TextBlock Text="输入数字简谱，自动转换为键盘脚本" Style="{StaticResource HintText}"
                           VerticalAlignment="Center" Margin="12,0,0,0"/>
            </StackPanel>
        </Grid>

        <!-- 信息卡 -->
        <Border Grid.Row="1" Style="{StaticResource OverlayCard}" Padding="18,14" Margin="2,0,2,10">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="曲名" Style="{StaticResource HintText}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox x:Name="SongNameTextBox" Width="200" Style="{StaticResource DarkTextBox}"/>
                    <TextBlock Text="艺术家" Style="{StaticResource HintText}" VerticalAlignment="Center" Margin="18,0,8,0"/>
                    <TextBox x:Name="ArtistTextBox" Width="160" Style="{StaticResource DarkTextBox}"/>
                    <TextBlock Text="BPM" Style="{StaticResource HintText}" VerticalAlignment="Center" Margin="18,0,8,0"/>
                    <TextBox x:Name="BpmTextBox" Width="70" Text="120" Style="{StaticResource DarkTextBox}"/>
                    <TextBlock Text="（默认120）" Style="{StaticResource HintText}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                </StackPanel>

                <Border Style="{StaticResource Chip}" Padding="14,10" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="简谱输入规则" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,6"/>
                        <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap" LineHeight="19">
                            <Run Text="音符："/><Run Text="1 2 3 4 5 6 7" Foreground="{StaticResource TextBrush}"/><Run Text=" 或 "/><Run Text="Z X C V B N M" Foreground="{StaticResource TextBrush}"/><Run Text=" 对应键盘按键 · "/><Run Text="," Foreground="{StaticResource TextBrush}"/><Run Text=" 表示高八度do"/>
                        </TextBlock>
                        <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap" LineHeight="19" Margin="0,3,0,0">
                            <Run Text="八度："/><Run Text="'" Foreground="{StaticResource TextBrush}"/><Run Text=" 升八度 · "/><Run Text="." Foreground="{StaticResource TextBrush}"/><Run Text=" 降八度   半音："/><Run Text="#" Foreground="{StaticResource TextBrush}"/><Run Text=" 升半音 · "/><Run Text="b" Foreground="{StaticResource TextBrush}"/><Run Text=" 降半音"/>
                        </TextBlock>
                        <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap" LineHeight="19" Margin="0,3,0,0">
                            <Run Text="时值：无空格=八分(0.5拍) · 1空格=四分(1拍) · 2空格=二分(2拍) · 附点"/><Run Text="·" Foreground="{StaticResource TextBrush}"/><Run Text="=×1.5 · 延音"/><Run Text="-" Foreground="{StaticResource TextBrush}"/><Run Text="+1拍 · 十六分"/><Run Text="~" Foreground="{StaticResource TextBrush}"/><Run Text="=0.25拍 · 休止"/><Run Text="0" Foreground="{StaticResource TextBrush}"/>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- 乐谱输入 -->
        <Border Grid.Row="2" Style="{StaticResource OverlayCard}" Padding="18,14" Margin="2,0,2,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="乐谱输入" Style="{StaticResource SectionTitle}" FontSize="13.5"/>
                    <Border Grid.Column="1" Style="{StaticResource Chip}" Padding="12,5">
                        <TextBlock x:Name="ParseStatusText" Text="等待输入…" Style="{StaticResource HintText}"/>
                    </Border>
                </Grid>

                <TextBox x:Name="NotationTextBox" Grid.Row="1"
                         AcceptsReturn="True" AcceptsTab="True"
                         TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                         FontFamily="Consolas" FontSize="13.5"
                         Style="{StaticResource DarkTextBox}"
                         TextChanged="NotationTextBox_TextChanged"
                         VerticalContentAlignment="Top"
                         Padding="14"/>
            </Grid>
        </Border>

        <!-- 底部按钮 -->
        <Border Grid.Row="3" Style="{StaticResource OverlayCard}" Padding="16,12" Margin="2,0,2,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="保存后将出现在「播放台」歌单中，可随时试听或发送按键演奏"
                           Style="{StaticResource HintText}" VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="PreviewButton" Content="▶ 试听" Style="{StaticResource OutlineButton}" Height="42" Click="Preview_Click" Margin="0,0,10,0"/>
                    <Button Content="⌨ 脚本" Style="{StaticResource GhostButton}" Height="42" Click="Script_Click" Margin="0,0,10,0"/>
                    <Button Content="清空" Style="{StaticResource GhostButton}" Click="Clear_Click" Margin="0,0,10,0"/>
                    <Button Content="保存歌曲" Style="{StaticResource PrimaryButton}" Width="140" Height="42" Click="SaveSong_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
