<Window x:Class="GameMusicPlayer.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="洲洲口风琴家"
        Icon="/icon.ico"
        Height="780" Width="1180"
        MinHeight="640" MinWidth="980"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="Transparent"
        FontFamily="Segoe UI, Microsoft YaHei UI">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="1"
                            CornerRadius="10"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border Background="{StaticResource BgBrush}"
            BorderBrush="{StaticResource StrokeBrush}"
            BorderThickness="1"
            CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="34"/>
            </Grid.RowDefinitions>

            <!-- ===== 标题栏 ===== -->
            <Border Grid.Row="0" Background="{StaticResource TitleGradient}"
                    CornerRadius="10,10,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                        <Border Width="28" Height="28" CornerRadius="8">
                            <Border.Background>
                                <ImageBrush ImageSource="/app-icon.png" Stretch="UniformToFill"/>
                            </Border.Background>
                        </Border>
                        <TextBlock Text="洲洲口风琴家" FontSize="13" FontWeight="Bold"
                                   Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"
                                   Margin="12,0,0,0"/>
                        <Border Style="{StaticResource Chip}" Margin="12,0,0,0" Padding="8,3" VerticalAlignment="Center">
                            <TextBlock Text="口风琴演奏助手" Style="{StaticResource HintText}"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="MinButton" Style="{StaticResource CaptionButton}" Click="Minimize_Click" ToolTip="最小化">
                            <Viewbox Width="11" Height="11">
                                <Path Data="M0,5.5 H10" StrokeThickness="1.2"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            </Viewbox>
                        </Button>
                        <Button x:Name="MaxButton" Style="{StaticResource CaptionButton}" Click="Maximize_Click" ToolTip="最大化">
                            <Viewbox Width="11" Height="11">
                                <Path x:Name="MaxGlyph" Data="M1,1 H9 V9 H1 Z" StrokeThickness="1.2"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            </Viewbox>
                        </Button>
                        <Button x:Name="CloseButton" Style="{StaticResource CaptionCloseButton}" Click="Close_Click" ToolTip="关闭">
                            <Viewbox Width="11" Height="11">
                                <Path Data="M1,1 L9,9 M9,1 L1,9" StrokeThickness="1.2"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            </Viewbox>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ===== 主体：侧栏 + 内容 ===== -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="212"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 侧栏 -->
                <Border Grid.Column="0" Background="{StaticResource SidebarGradient}">
                    <Grid Margin="0,10,0,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="功能" Style="{StaticResource HintText}" Margin="22,4,0,10"/>

                        <StackPanel Grid.Row="1">
                            <RadioButton x:Name="NavPlayer" Style="{StaticResource NavButton}" GroupName="nav"
                                         Tag="player" Checked="Nav_Checked" IsChecked="True">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="26" Height="26" CornerRadius="7" Background="#FF132430">
                                        <TextBlock Text="▶" FontSize="11" Foreground="{StaticResource AccentBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="播放台" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>

                            <RadioButton x:Name="NavLive" Style="{StaticResource NavButton}" GroupName="nav"
                                         Tag="live" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="26" Height="26" CornerRadius="7" Background="#FF132430">
                                        <TextBlock Text="◉" FontSize="11" Foreground="{StaticResource AmberBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="实时录制" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>

                            <RadioButton x:Name="NavInput" Style="{StaticResource NavButton}" GroupName="nav"
                                         Tag="input" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="26" Height="26" CornerRadius="7" Background="#FF132430">
                                        <TextBlock Text="✎" FontSize="11" Foreground="{StaticResource AccentBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="手动录入" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>

                            <RadioButton x:Name="NavRecognize" Style="{StaticResource NavButton}" GroupName="nav"
                                         Tag="recognize" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="26" Height="26" CornerRadius="7" Background="#FF132430">
                                        <TextBlock Text="📷" FontSize="11" Foreground="{StaticResource AccentBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="AI识别" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>

                        <StackPanel Grid.Row="3" Margin="14,0">
                            <Border Style="{StaticResource Chip}" Padding="12,10">
                                <StackPanel>
                                    <TextBlock Text="全局热键" Style="{StaticResource HintText}" Margin="0,0,0,6"/>
                                    <TextBlock Text="F7   上一首（小助手内）" FontSize="11" Foreground="{StaticResource TextBrush}" Margin="0,0,0,3"/>
                                    <TextBlock Text="F8   播放 / 暂停（小助手内）" FontSize="11" Foreground="{StaticResource TextBrush}" Margin="0,0,0,3"/>
                                    <TextBlock Text="F9   下一首（小助手内）" FontSize="11" Foreground="{StaticResource TextBrush}" Margin="0,0,0,3"/>
                                    <TextBlock Text="`   显示 / 隐藏小助手" FontSize="11" Foreground="{StaticResource AccentBrush}"/>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="v1.1 · Delta UI" Style="{StaticResource HintText}"
                                       HorizontalAlignment="Center" Margin="0,12,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 内容区 -->
                <ContentControl x:Name="ContentHost" Grid.Column="1" Margin="14,12,14,12"/>
            </Grid>

            <!-- ===== 状态栏 ===== -->
            <Border Grid.Row="2" Background="{StaticResource TitleGradient}" CornerRadius="0,0,10,10">
                <Grid Margin="16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{StaticResource MutedBrush}" Margin="0,0,8,0"/>
                        <TextBlock x:Name="GlobalStatusText" Text="就绪" FontSize="11.5" Foreground="{StaticResource SubTextBrush}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="音量" FontSize="11" Foreground="{StaticResource SubTextBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <Slider x:Name="GlobalVolumeSlider" Width="110" Minimum="0" Maximum="1" Value="0.7"
                                Style="{StaticResource DarkSlider}" VerticalAlignment="Center"
                                ValueChanged="GlobalVolumeSlider_ValueChanged"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ===== Toast 通知 ===== -->
            <ItemsControl x:Name="ToastHost" Panel.ZIndex="80"
                          HorizontalAlignment="Right" VerticalAlignment="Top"
                          Margin="0,58,18,0" IsHitTestVisible="False"/>

            <!-- ===== 覆盖层（站内确认/提示，替代弹窗） ===== -->
            <Border x:Name="OverlayLayer" Panel.ZIndex="100"
                    Grid.Row="0" Grid.RowSpan="3"
                    Background="#B004070B"
                    Visibility="Collapsed">
                <Border Style="{StaticResource OverlayCard}" Width="430" Margin="24"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Padding="28,24">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="4" CornerRadius="2" Background="{StaticResource AccentBrush}" Margin="0,0,12,0"/>
                            <TextBlock x:Name="OverlayTitle" Text="提示" FontSize="17" FontWeight="SemiBold"/>
                        </StackPanel>
                        <TextBlock x:Name="OverlayMessage" Text="" FontSize="13"
                                   Foreground="{StaticResource SubTextBrush}"
                                   TextWrapping="Wrap" Margin="16,14,0,24" LineHeight="20"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="OverlayCancel" Content="取消" Style="{StaticResource OutlineButton}"
                                    Width="100" Click="OverlayCancel_Click"/>
                            <Button x:Name="OverlayConfirm" Content="确定" Style="{StaticResource PrimaryButton}"
                                    Width="100" Margin="10,0,0,0" Click="OverlayConfirm_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Border>

            <!-- ===== 按键脚本查看器 ===== -->
            <Border x:Name="ScriptOverlay" Panel.ZIndex="101"
                    Grid.Row="0" Grid.RowSpan="3"
                    Background="#B004070B"
                    Visibility="Collapsed">
                <Border Style="{StaticResource OverlayCard}" Width="720" Height="560" Margin="24"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Padding="26,22">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
                            <Border Width="4" CornerRadius="2" Background="{StaticResource AccentBrush}" Margin="0,0,12,0"/>
                            <TextBlock x:Name="ScriptTitle" Text="按键脚本" FontSize="17" FontWeight="SemiBold"/>
                            <TextBlock Text="  发送到游戏的按键序列" Style="{StaticResource HintText}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <TextBox x:Name="ScriptText" Grid.Row="1"
                                 IsReadOnly="True" IsReadOnlyCaretVisible="True"
                                 TextWrapping="NoWrap" AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                 FontFamily="Consolas" FontSize="13"
                                 Style="{StaticResource DarkTextBox}"/>

                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                            <Button Content="复制全部" Style="{StaticResource OutlineButton}" Width="110" Height="40" Click="ScriptCopy_Click"/>
                            <Button Content="关闭" Style="{StaticResource PrimaryButton}" Width="110" Height="40" Margin="10,0,0,0" Click="ScriptClose_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Border>
        </Grid>
    </Border>
</Window>
