<UserControl x:Class="GameMusicPlayer.Views.PlayerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI, Microsoft YaHei UI">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="330"/>
        </Grid.ColumnDefinitions>

        <!-- ===== 歌单 ===== -->
        <Border Grid.Column="0" Style="{StaticResource OverlayCard}" Margin="0,0,12,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="56"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" BorderBrush="{StaticResource StrokeSoftBrush}" BorderThickness="0,0,0,1" Padding="18,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="4" Height="18" CornerRadius="2" Background="{StaticResource AccentBrush}" Margin="0,0,10,0"/>
                            <TextBlock Text="歌单" Style="{StaticResource SectionTitle}"/>
                            <TextBlock x:Name="SongCountText" Text=" 0 首" Style="{StaticResource HintText}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="♪ 音频试听 · ⌨ 查看脚本 · 播放在小助手中操作" Style="{StaticResource HintText}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <ListBox x:Name="SongListBox" Grid.Row="1"
                         ItemContainerStyle="{StaticResource RoundedListItem}"
                         SelectionChanged="SongListBox_SelectionChanged"
                         MouseDoubleClick="SongListBox_MouseDoubleClick"
                         BorderThickness="0" Background="Transparent" Padding="6,8"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontSize="14.5" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <TextBlock Text="{Binding Artist}" Style="{StaticResource HintText}"/>
                                        <TextBlock Text=" · " Style="{StaticResource HintText}"/>
                                        <TextBlock Text="{Binding DurationDisplay}" Style="{StaticResource HintText}"/>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="♪ 试听" Tag="{Binding Id}" Click="PreviewSong_Click"
                                            Background="Transparent" Foreground="{StaticResource TextBrush}"
                                            BorderThickness="0" Padding="10,6" Cursor="Hand" FontSize="12">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="b" Background="Transparent" CornerRadius="7" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="b" Property="Background" Value="#FF1B2A38"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <Button Content="⌨ 脚本" Tag="{Binding Id}" Click="Script_Click"
                                            Background="Transparent" Foreground="{StaticResource SubTextBrush}"
                                            BorderThickness="0" Padding="10,6" Cursor="Hand" FontSize="12">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="b" Background="Transparent" CornerRadius="7" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                                        <Setter TargetName="b" Property="Background" Value="#FF1B2A38"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <Button Content="删除" Tag="{Binding Id}" Click="DeleteSong_Click"
                                            Background="Transparent" Foreground="{StaticResource MutedBrush}"
                                            BorderThickness="0" Padding="10,6" Cursor="Hand" FontSize="12">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="b" Background="Transparent" CornerRadius="7" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                                        <Setter TargetName="b" Property="Background" Value="#FF2A1A1C"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- ===== 播放卡 ===== -->
        <Border Grid.Column="1" Style="{StaticResource OverlayCard}" Padding="22">
            <StackPanel VerticalAlignment="Center">
                <Border Height="180" CornerRadius="14" Margin="0,0,0,18">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#FF15303C" Offset="0"/>
                            <GradientStop Color="#FF0E1A24" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="♫" FontSize="64" Foreground="{StaticResource AccentBrush}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock x:Name="NowPlayingText" Text="未在播放" Style="{StaticResource HintText}"
                                   HorizontalAlignment="Center" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <TextBlock x:Name="CurrentSongName" Text="选择一首歌曲" FontSize="18" FontWeight="Bold"
                           HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="CurrentSongArtist" Text="" Style="{StaticResource HintText}"
                           HorizontalAlignment="Center" Margin="0,6,0,0"/>

                <ProgressBar x:Name="PlaybackProgress" Style="{StaticResource DarkProgressBar}" Margin="0,20,0,0"/>

                <Button x:Name="StartPlayButton" Content="▶ 开始播放" Style="{StaticResource PrimaryButton}"
                        HorizontalAlignment="Stretch" Margin="0,22,0,0" Click="StartPlay_Click"/>
                <TextBlock Text="打开小助手后，在小助手内操作才真正播放脚本" Style="{StaticResource HintText}"
                           HorizontalAlignment="Center" Margin="0,8,0,0" TextWrapping="Wrap" TextAlignment="Center"/>

                <Button x:Name="PreviewAudioButton" Content="♪ 试听音频（不发按键）" Style="{StaticResource OutlineButton}"
                        HorizontalAlignment="Stretch" Margin="0,18,0,0" Click="PreviewAudio_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
