<UserControl x:Class="GameMusicPlayer.Views.LiveRecordView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI, Microsoft YaHei UI">

    <UserControl.Resources>
        <Style x:Key="RecordButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="22,11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="root" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#FFFF6B6B" Offset="0"/>
                                    <GradientStop Color="#FFD93A42" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="root" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="root" Property="Opacity" Value="0.78"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 头部：标题 + 状态 + 计时 -->
        <Grid Grid.Row="0" Margin="2,0,2,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="4" Height="22" CornerRadius="2" Background="{StaticResource AmberBrush}" Margin="0,0,12,0"/>
                <TextBlock Text="实时录制" Style="{StaticResource SectionTitle}" FontSize="17"/>
                <TextBlock Text="按下第一个按键即开始计时 · 试听/监听均为音频播放，不发送按键"
                           Style="{StaticResource HintText}" VerticalAlignment="Center" Margin="12,0,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Style="{StaticResource Chip}" Padding="12,7" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{StaticResource MutedBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="StatusText" Text="待机" FontSize="12" Foreground="{StaticResource TextBrush}" Width="54"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Chip}" Padding="14,7">
                    <TextBlock x:Name="TimerText" Text="00:00.00" FontFamily="Consolas" FontSize="16"
                               Foreground="{StaticResource AccentBrush}"/>
                </Border>
            </StackPanel>
        </Grid>

        <!-- 设置卡 -->
        <Border Grid.Row="1" Style="{StaticResource OverlayCard}" Padding="16,12" Margin="2,0,2,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="曲名" Style="{StaticResource HintText}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox x:Name="SongNameTextBox" Width="180" Style="{StaticResource DarkTextBox}"/>
                        <TextBlock Text="艺术家" Style="{StaticResource HintText}" VerticalAlignment="Center" Margin="16,0,8,0"/>
                        <TextBox x:Name="ArtistTextBox" Width="140" Style="{StaticResource DarkTextBox}"/>
                        <TextBlock Text="量化" Style="{StaticResource HintText}" VerticalAlignment="Center" Margin="16,0,8,0"/>
                        <RadioButton x:Name="QuantizeOff" Style="{StaticResource ChipToggle}" GroupName="quantize" Tag="0"
                                     Content="关" Checked="Settings_Changed"/>
                        <RadioButton Style="{StaticResource ChipToggle}" GroupName="quantize" Tag="10"
                                     Content="10ms" Checked="Settings_Changed"/>
                        <RadioButton x:Name="Quantize25" Style="{StaticResource ChipToggle}" GroupName="quantize" Tag="25"
                                     Content="25ms" IsChecked="True" Checked="Settings_Changed"/>
                        <RadioButton Style="{StaticResource ChipToggle}" GroupName="quantize" Tag="50"
                                     Content="50ms" Checked="Settings_Changed"/>
                        <RadioButton Style="{StaticResource ChipToggle}" GroupName="quantize" Tag="100"
                                     Content="100ms" Checked="Settings_Changed"/>
                        <TextBlock Text="最短" Style="{StaticResource HintText}" VerticalAlignment="Center" Margin="12,0,8,0"/>
                        <TextBox x:Name="MinDurationBox" Width="54" Text="50" Style="{StaticResource DarkTextBox}" TextChanged="Settings_Changed"/>
                        <TextBlock Text="ms" Style="{StaticResource HintText}" VerticalAlignment="Center" Margin="5,0,0,0"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <CheckBox x:Name="PreviewSoundCheckBox" Content="试听发声" IsChecked="True" Style="{StaticResource DarkCheckBox}" Margin="0,0,22,0"/>
                        <CheckBox x:Name="MonitorCheckBox" Content="录入监听" IsChecked="True" Style="{StaticResource DarkCheckBox}"/>
                        <TextBlock Text="鼠标任意位置生效：左=降八度  右=升八度  中键=半音辅助（中+左=降半音 · 中+右=升半音）"
                                   Style="{StaticResource HintText}" VerticalAlignment="Center" Margin="22,0,0,0"/>
                    </StackPanel>
                </StackPanel>

                <Border Grid.Column="1" Style="{StaticResource Chip}" Padding="14,8" VerticalAlignment="Center" Margin="16,0,0,0">
                    <TextBlock x:Name="CountText" Text="已录入 0 个音符" FontSize="12"
                               Foreground="{StaticResource AccentBrush}"/>
                </Border>
            </Grid>
        </Border>

        <!-- 虚拟键盘 -->
        <Border Grid.Row="2" Style="{StaticResource OverlayCard}" Padding="16,12" Margin="2,0,2,10">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="虚拟键盘" Style="{StaticResource SectionTitle}" FontSize="13.5"/>
                    <TextBlock Text="  按键 Z X C V B N M , 或 1-7 · 松开记录时值 · 鼠标在任意位置（含游戏窗口）按住左/右/中键均可升降调，焦点被抢也能继续录"
                               Style="{StaticResource HintText}" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel x:Name="KeyboardLowPanel" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                <StackPanel x:Name="KeyboardHighPanel" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,0"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                    <TextBlock x:Name="ModifierText" Text="当前: 普通" FontSize="12"
                               Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                    <ToggleButton x:Name="SharpChip" Style="{StaticResource ChipToggle}" Content="↑ 升八度 (右键)" Click="ModChip_Click" Tag="sharp"/>
                    <ToggleButton x:Name="FlatChip" Style="{StaticResource ChipToggle}" Content="↓ 降八度 (左键)" Click="ModChip_Click" Tag="flat"/>
                    <ToggleButton x:Name="NaturalChip" Style="{StaticResource ChipToggle}" Content="♯ 半音 (中键)" Click="ModChip_Click" Tag="natural"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 时间轴 + 明细 -->
        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource OverlayCard}" Padding="12,10" Margin="2,0,2,10">
                <StackPanel>
                    <TextBlock Text="时间轴" Style="{StaticResource HintText}" Margin="2,0,0,6"/>
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Height="58">
                        <Canvas x:Name="TimelineCanvas" Height="58" Background="#FF0B1118"/>
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource OverlayCard}" Margin="2,0,2,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="38"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" BorderBrush="{StaticResource StrokeSoftBrush}" BorderThickness="0,0,0,1" Padding="16,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="36"/>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="50"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="#" Style="{StaticResource HintText}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="按键" Style="{StaticResource HintText}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="类型" Style="{StaticResource HintText}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Text="起点" Style="{StaticResource HintText}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="4" Text="时值" Style="{StaticResource HintText}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="5" Text="状态" Style="{StaticResource HintText}" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <ListBox x:Name="NotesListBox" Grid.Row="1" BorderThickness="0" Background="Transparent"
                             Padding="8,4" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36"/>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="50"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding IndexText}" FontSize="12" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" FontFamily="Consolas"/>
                                    <TextBlock Grid.Column="1" Text="{Binding KeyText}" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" FontFamily="Consolas"/>
                                    <TextBlock Grid.Column="2" Text="{Binding TypeText}" FontSize="12" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="3" Text="{Binding StartText}" FontSize="12" Foreground="{StaticResource SubTextBrush}" VerticalAlignment="Center" FontFamily="Consolas"/>
                                    <TextBlock Grid.Column="4" Text="{Binding DurationText}" FontSize="12" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" FontFamily="Consolas"/>
                                    <TextBlock Grid.Column="5" Text="{Binding StateText}" FontSize="12" Foreground="{StaticResource SubTextBrush}" VerticalAlignment="Center"/>
                                    <Button Grid.Column="6" Content="✕" Tag="{Binding RowIndex}" Click="DeleteNote_Click"
                                            Background="Transparent" Foreground="{StaticResource MutedBrush}" BorderThickness="0"
                                            Padding="8,3" FontSize="11" Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="b" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                                        <Setter TargetName="b" Property="Background" Value="#FF2A1A1C"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>

        <!-- 传输控制条 -->
        <Border Grid.Row="4" Style="{StaticResource OverlayCard}" Padding="16,12" Margin="2,12,2,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="RecordButton" Content="● 开始录制 (F5)" Style="{StaticResource RecordButton}" Click="RecordPause_Click" Margin="0,0,10,0"/>
                    <Button x:Name="StopButton" Content="■ 结束录制 (F6)" Style="{StaticResource OutlineButton}" Click="Stop_Click" Margin="0,0,10,0"/>
                    <Button x:Name="PreviewButton" Content="▶ 试听" Style="{StaticResource OutlineButton}" Click="Preview_Click" Margin="0,0,10,0"/>
                    <Button Content="↶ 撤销" Style="{StaticResource GhostButton}" Click="Undo_Click" Margin="0,0,6,0"/>
                    <Button x:Name="ClearButton" Content="清空" Style="{StaticResource GhostButton}" Click="Clear_Click"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="SaveHintText" Text="结束后可保存" Style="{StaticResource HintText}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                    <Button x:Name="CancelSaveButton" Content="取消保存" Style="{StaticResource OutlineButton}" Width="110" Height="42"
                            Click="CancelSave_Click" Visibility="Collapsed" Margin="0,0,10,0"/>
                    <Button x:Name="SaveButton" Content="保存歌曲" Style="{StaticResource PrimaryButton}" Width="130" Height="42"
                            Click="SaveSong_Click" Visibility="Collapsed"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
